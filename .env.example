# PostgreSQL with the pgvector extension
DATABASE_URL="postgresql://USER@localhost:5432/hybrid_search"

# Any OpenAI-compatible embeddings endpoint (llama.cpp server, OpenAI, Gemini, LiteLLM)
EMBEDDING_BASE_URL="http://127.0.0.1:8081/v1"
EMBEDDING_MODEL="nomic-embed-text-v1.5"
EMBEDDING_API_KEY=""
EMBEDDING_DIMENSIONS="768"
# Task prefixes required by nomic-embed-text. Leave empty for models that do not use them.
EMBEDDING_QUERY_PREFIX="search_query: "
EMBEDDING_DOCUMENT_PREFIX="search_document: "
EMBEDDING_BATCH_SIZE="16"

# Search tuning; see `hybrid-search ann-sweep` and `hybrid-search tune-fusion`
HNSW_EF_SEARCH="40"
FUSION_KEYWORD_WEIGHT="1.0"

# Optional reranking stage (see docs/adr/0008). Leave RERANK_BASE_URL empty to disable it.
RERANK_BASE_URL=""
RERANK_MODEL="jina-reranker-v1-turbo-en"
RERANK_API_KEY=""
RERANK_DEPTH="20"
RERANK_WEIGHT="0.25"

# Optional. Defaults to DATABASE_URL with the database name changed to hybrid_search_test.
# TEST_DATABASE_URL="postgresql://USER@localhost:5432/hybrid_search_test"

LOG_LEVEL="INFO"
